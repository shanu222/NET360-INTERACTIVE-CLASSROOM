{
  "name": "net360-interactive-classroom",
  "private": true,
  "version": "0.1.0",
  "description": "Meeto360 — live 3D classes and meetings around one synchronized board.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev -w apps/server\" \"npm:dev -w apps/web\"",
    "build": "npm run build -w apps/web",
    "start": "npm start -w apps/server",
    "typecheck": "tsc -p packages/protocol && tsc -p packages/board-engine && tsc -p apps/server && tsc -p apps/web",
    "loadtest": "tsx scripts/loadtest.ts",
    "test:restart": "tsx scripts/restart-test.ts",
    "test:chat": "tsx scripts/chat-test.ts",
    "test:present": "tsx scripts/present-test.ts",
    "test:modes": "tsx scripts/modes-test.ts",
    "test:capacity": "tsx scripts/capacity-test.ts",
    "db:local": "node scripts/d1-local.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=20"
  }
}
