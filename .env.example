# Copy to .env and fill in. Everything is optional for local development:
# with no Firebase settings the app runs in dev mode (sign in with just a name).

PORT=4000

# ---------- Firebase sign-in (production) ----------
# Server: verifies the ID tokens students and teachers sign in with.
FIREBASE_PROJECT_ID=
# Optional: service-account JSON on one line (needed later for Firestore persistence).
FIREBASE_SERVICE_ACCOUNT=
# Optional: only these emails may start classes (comma-separated). Empty = any signed-in user.
TEACHER_EMAILS=

# Web app (Firebase console → Project settings → Your apps → Web app config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ---------- Video and voice (LiveKit, Phase 4) ----------
# Works the same with LiveKit Cloud or self-hosted LiveKit — only these three values change.
#   LiveKit Cloud:  LIVEKIT_URL=wss://your-project.livekit.cloud  (keys from cloud.livekit.io)
#   Self-hosted:    LIVEKIT_URL=ws://localhost:7880 with `docker compose up livekit` (dev keys below)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
