# Copy to .env for local development. In production these are set in the hosts'
# dashboards — see DEPLOY.md. Everything is optional locally: with no Firebase
# settings the app runs in dev mode (sign in with just a name), and with no
# Cloudflare settings classes live in memory only.

# =====================  Railway — realtime server  =====================

# Railway: tells it to build the server's Dockerfile (Railway ignores this locally).
RAILWAY_DOCKERFILE_PATH=apps/server/Dockerfile

# Railway sets PORT itself. Locally:
PORT=4000

# Web addresses allowed to call the server, comma-separated, no trailing slash.
# e.g. https://net360-classroom.vercel.app,https://classroom.net360.pk
ALLOWED_ORIGINS=

# Firebase sign-in: the server verifies ID tokens for this project.
FIREBASE_PROJECT_ID=
# Optional: only these emails may start classes. Empty = any signed-in user.
TEACHER_EMAILS=

# Cloudflare D1 — sessions, attendance, hands, board snapshots.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
# API token with "Account · D1 · Edit" permission.
CLOUDFLARE_API_TOKEN=
# Cloudflare R2 — saved boards of any size. R2 → Manage API Tokens → Object Read & Write
# on this bucket; use the S3 "Access Key ID" and "Secret Access Key" it shows.
# The endpoint defaults to https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# How often changed boards are saved (seconds). Boards are also saved on shutdown.
SNAPSHOT_EVERY_SECONDS=3

# Video (Phase 4) — LiveKit Cloud or self-hosted; only these three change.
#   Cloud:        wss://your-project.livekit.cloud
#   Self-hosted:  wss://livekit.your-domain.com   (local: docker compose up livekit → ws://localhost:7880, devkey/secret)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# =====================  Vercel — web app  =====================
# VITE_* values are built into the web app: redeploy on Vercel after changing them.

# The Railway server's public address. Leave empty when the server also serves the web app.
VITE_API_URL=

# Firebase console → Project settings → Your apps → Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
